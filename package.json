{
	"name": "maths-engine",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run src/server.ts",
		"devtools": "bunx @ai-sdk/devtools",
		"build": "bun build src/server.ts --outdir dist --target bun --minify",
		"start": "bun run build && bun run dist/server.js",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.12",
		"@types/bun": "latest",
		"@types/express": "^5.0.6",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"@types/node": "^25.6.0"
	},
	"lint-staged": {
		"*.{ts,js,json}": "biome check --write"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@ai-sdk/devtools": "^0.0.15",
		"@ai-sdk/openai": "^3.0.53",
		"@prisma/adapter-pg": "^7.7.0",
		"ai": "^6.0.168",
		"axios": "^1.16.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"helmet": "^8.1.0",
		"pg": "^8.20.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"pino-pretty": "^13.1.3",
		"zod": "^4.3.6"
	}
}
